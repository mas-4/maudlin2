[Unit]
Description=Maudlin scrape and site build
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=oneshot
User=mas
Group=mas
WorkingDirectory=/home/mas/Repos/maudlin2
# After a wake from sleep the network takes a few seconds to come back; wait (up to a minute) for DNS
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts api.votehub.com >/dev/null && exit 0; sleep 2; done; exit 0'
ExecStart=/home/mas/Repos/maudlin2/scripts/run.sh
# A hung run must not block the next hour forever
TimeoutStartSec=45min
Nice=5
