[Unit]
# The person, Oct 11: the machine could stay up all night for the worker and experiments "if the gpu didn't glow up the
# entire room like a discotheque". The MSI card and the board's JRAINBOW headers (the case fans) go back to their
# rainbow at boot and after sleep, so this sets them dark at boot and after every wake: the card in Direct mode set to
# black (its own Off mode didn't take: it stayed on the rainbow), the board in static black (it has no Off). The Yeti X
# mic is left alone: its light shows when it's muted.
# Install (and again after a change): a copy, not a link: a link into /home dangles at boot, when systemd reads its
# units before /home is mounted (Oct 11: the linked unit never ran at boot)
#   sudo rm -f /etc/systemd/system/rgb-off.service && sudo cp /home/mas/Repos/maudlin2/deploy/systemd/rgb-off.service
#   /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable rgb-off.service
Description=Turn the GPU and motherboard lighting off, at boot and after every wake
After=systemd-modules-load.service suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/usr/bin/openrgb --noautoconnect -d "MSI GeForce RTX 3080 Gaming Z Trio LHR" -m Direct -c 000000 -d "MSI PRO Z790-P WIFI (MS-7E06)" -m Static -c 000000
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
