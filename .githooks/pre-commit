#!/bin/bash
# Run the test suite before every commit (about 30 seconds; it uses the local database).
# Installed with: git config core.hooksPath .githooks    Skip once with: git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
.venv/bin/python -m pytest -q -x 2>&1 | tail -3
exit "${PIPESTATUS[0]}"
