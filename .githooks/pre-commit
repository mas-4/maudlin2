#!/bin/bash
# Lint (ruff, under a second; rules in ruff.toml) and run the test suite before every commit (about a minute; it uses
# the local database).
# Installed with: git config core.hooksPath .githooks    Skip once with: git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
.venv/bin/ruff check --quiet . || { echo "ruff found problems (.venv/bin/ruff check . --fix fixes the simple ones)"; exit 1; }
.venv/bin/python -m pytest -q -x 2>&1 | tail -3
exit "${PIPESTATUS[0]}"
